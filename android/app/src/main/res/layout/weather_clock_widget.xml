<?xml version="1.0" encoding="utf-8"?>
<!--
  چیدمان جدید: به‌جای تقسیم صفحه به ستون‌های ثابت، همه‌ی متغیرها
  (ساعت، شهر+دما+وضعیت هوا، یادآوری، روز هفته، تاریخ‌ها) در یک متن
  پیوسته با جداکننده «•» پشت سر هم چیده می‌شوند. این متن به‌صورت
  طبیعیِ TextView، وقتی در یک سطر جا نشود، به سطر بعدی می‌شکند
  (حداکثر ۳ سطر، طبق ارتفاع حداکثریِ مجاز ویجت). محتوای هر بخش و
  رنگ/اندازه‌ی نسبی‌اش در WeatherClockWidgetProvider.kt ساخته می‌شود.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="top|end"
        android:textDirection="rtl"
        android:textAlignment="gravity"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="—" />

</FrameLayout>
