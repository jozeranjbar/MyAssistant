<?xml version="1.0" encoding="utf-8"?>
<!--
  چیدمان سه‌ستونه‌ی ثابت (مستقل از جهت زبان سیستم):
  ستون ۱ (راست‌ترین، همیشه چسبیده به لبه‌ی راست): شهر+دما+آیکون ابر / روز هفته+تاریخ شمسی
  ستون ۲ (همیشه وسط‌چینِ کل ویجت، در هر عرضی): ساعت / تاریخ قمری
  ستون ۳ (چپ‌ترین، همیشه چسبیده به لبه‌ی چپ): یادآوری / تاریخ میلادی
  هر ستون به عرض واقعی خودش (نسبت به سهم وزنی‌اش) محدود شده تا در صورت
  کمبود جا، متن به‌جای روی‌هم‌افتادن با سایر ستون‌ها، با «…» بریده شود.
  اندازه‌ی فونت‌ها به‌صورت پویا و متناسب با عرض/ارتفاع واقعی ویجت، توسط
  WeatherClockWidgetProvider.kt تنظیم می‌شود (اعداد پایه در این فایل صرفاً
  مقدار اولیه/پیش‌فرض قبل از اولین بروزرسانی هستند).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- ردیف ۱: یادآوری (چپ) | ساعت (وسط) | شهر+دما+ابر (راست) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ستون ۳ - یادآوری - چسبیده به چپ، محدود به عرض واقعی ستون -->
            <TextView
                android:id="@+id/widget_reminder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="36"
                android:gravity="left|center_vertical"
                android:text="0 یادآوری"
                android:textColor="#FFD54F"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- ستون ۲ - ساعت - همیشه وسط‌چین، محدود به عرض واقعی ستون -->
            <TextView
                android:id="@+id/widget_clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="28"
                android:gravity="center"
                android:text="--:--"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- ستون ۱ - شهر/دما/ابر - چسبیده به راست، محدود به عرض واقعی ستون -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="36"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:gravity="right|center_vertical">

                <TextView
                    android:id="@+id/widget_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#8ED8FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="--°"
                    android:textColor="#8ED8FF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_weather_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="🌤️"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"></FrameLayout>

        <!-- ردیف ۲: میلادی (چپ) | قمری (وسط) | هفته+شمسی (راست) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ستون ۳ - تاریخ میلادی - چسبیده به چپ -->
            <TextView
                android:id="@+id/widget_date_gregorian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="36"
                android:gravity="left|center_vertical"
                android:text="—"
                android:textColor="#000000"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- ستون ۲ - تاریخ قمری - همیشه وسط‌چین -->
            <TextView
                android:id="@+id/widget_date_hijri"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="28"
                android:gravity="center"
                android:text="—"
                android:textColor="#000000"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- ستون ۱ - روز هفته + تاریخ شمسی - چسبیده به راست -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="36"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:gravity="right|center_vertical">

                <TextView
                    android:id="@+id/widget_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_date_shamsi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="—"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
